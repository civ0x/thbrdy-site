---
import PrepView from '../../../components/prep/PrepView.astro';
import { getCollection } from 'astro:content';

const stories = await getCollection('stories');
const defaultStory = stories
  .slice()
  .sort((a, b) => a.data.tagline.localeCompare(b.data.tagline))[0];
---

<PrepView selectedStory={defaultStory} linkPrefix="" />
