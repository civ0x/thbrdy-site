---
import Base from '../../layouts/Base.astro';
import { NoticeInteractionFlow } from '../../components/islands/NoticeInteractionFlow.tsx';
import NoticeVisionLeadTime from '../../components/islands/NoticeVisionLeadTime.tsx';
import { NoticeCompetitiveGap } from '../../components/islands/NoticeCompetitiveGap.tsx';
---

<Base title="Notice — Investor Deck" description="Interactive investor deck for Notice: multi-device AI-assisted interoception training.">
  <div class="deck-page">
    <header class="deck-header">
      <div class="deck-header__inner">
        <div class="deck-header__left">
          <span class="deck-header__eyebrow">NOTICE</span>
          <span class="deck-header__title">Investor Deck</span>
        </div>
        <div class="deck-header__right">
          <a href="/notice/vision/" class="deck-header__link">Vision</a>
          <span class="deck-header__sep">&middot;</span>
          <a href="/notice/roadmap/" class="deck-header__link">Roadmap</a>
          <span class="deck-header__sep">&middot;</span>
          <a href="/notice-investor-deck.pdf" class="deck-header__link">PDF</a>
          <span class="deck-header__sep">&middot;</span>
          <a href="/notice-investor-deck.pptx" class="deck-header__link" download>PPTX</a>
          <span class="deck-header__sep">&middot;</span>
          <a href="/notice/" class="deck-header__link">&larr; Notice Hub</a>
        </div>
      </div>
    </header>

    <div class="deck" id="deck">

      <!-- Slide 1: Title -->
      <section class="slide slide--dark" id="slide-1" aria-label="Title">
        <div class="slide__inner">
          <img src="/images/enso-transparent.png" alt="" class="s1-enso dk-reveal" width="80" height="80" />
          <h1 class="s1-title dk-reveal">Notice</h1>
          <p class="s1-tagline dk-reveal"><em>Train the skill the body already knows.</em></p>
          <p class="s1-subtitle dk-reveal">Multi-device AI-assisted interoception training</p>
          <div class="s1-contact dk-reveal">
            Thomas Brady &middot; thbrdy@pando.industries &middot; notice.tools &middot; Pando Industries
          </div>
        </div>
      </section>

      <!-- Slide 2: The Gap -->
      <section class="slide" id="slide-2" aria-label="The Gap">
        <div class="slide__inner">
          <div class="slide-eyebrow dk-reveal" style="text-align: center">THE GAP</div>
          <h2 class="slide-heading dk-reveal" style="text-align: center">Your body knows before you do.</h2>
          <div class="s2-cards">
            <div class="s2-card dk-reveal" style="transition-delay: 0ms">
              <strong>HRV drops before anxiety arrives</strong>
              <span>Heart rate variability decreases measurably 5–15 minutes before people report feeling anxious.</span>
            </div>
            <div class="s2-card dk-reveal" style="transition-delay: 150ms">
              <strong>Heart rate climbs before excitement registers</strong>
              <span>Cardiac acceleration precedes conscious awareness of arousal states.</span>
            </div>
            <div class="s2-card dk-reveal" style="transition-delay: 300ms">
              <strong>Skin conductance shifts before you can name the feeling</strong>
              <span>Electrodermal activity changes before emotional labeling is possible.</span>
            </div>
          </div>
          <div class="s2-insight dk-reveal" style="transition-delay: 400ms">
            <p>Interoceptive accuracy is not a fixed trait.<br/>It is a skill. It is trainable.<br/>But no product measures the training.</p>
          </div>
        </div>
      </section>

      <!-- Slide 3: The Product -->
      <section class="slide" id="slide-3" aria-label="The Product">
        <div class="slide__inner">
          <div class="slide-eyebrow dk-reveal" style="text-align: center">THE PRODUCT</div>
          <h2 class="slide-heading dk-reveal" style="text-align: center">Frame Snap: capture, label, reflect.</h2>
          <div class="notice-island-wrap">
            <NoticeInteractionFlow client:visible />
          </div>
          <div class="s3-features dk-reveal">
            <div class="s3-feature">
              <strong>Affect labeling</strong>
              <span>validated emotional regulation technique</span>
            </div>
            <div class="s3-feature">
              <strong>3 reflection timescales</strong>
              <span>witness, debrief, synthesis</span>
            </div>
            <div class="s3-feature">
              <strong>Scaffolding decay</strong>
              <span>users graduate, not churn</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Slide 4: Novel Metric -->
      <section class="slide" id="slide-4" aria-label="Novel Metric">
        <div class="slide__inner">
          <div class="slide-eyebrow dk-reveal" style="text-align: center">INTEROCEPTIVE LEAD TIME</div>
          <h2 class="slide-heading dk-reveal" style="text-align: center">The metric no one else measures</h2>
          <div class="notice-island-wrap">
            <NoticeVisionLeadTime client:visible />
          </div>
          <div class="s4-callout dk-reveal">
            <p>If lead time reduction correlates with MAIA-2 score improvement — that's a peer-reviewable finding.</p>
          </div>
        </div>
      </section>

      <!-- Slide 5: Privacy as Topology -->
      <section class="slide" id="slide-5" aria-label="Privacy as Topology">
        <div class="slide__inner">
          <div class="slide-eyebrow dk-reveal" style="text-align: center">PRIVACY AS TOPOLOGY</div>
          <h2 class="slide-heading dk-reveal" style="text-align: center">Three trust paths, one protocol.</h2>
          <div class="s5-cards">
            <div class="s5-device s5-device--green dk-reveal" style="transition-delay: 0ms">
              <div class="s5-device__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="6" y="4" width="12" height="16" rx="2" />
                  <path d="M9 1h6M9 23h6" />
                  <polyline points="10 8 12 10 14 8" />
                </svg>
              </div>
              <div class="s5-device__header">Apple Watch</div>
              <div class="s5-device__trust">On-device only</div>
              <div class="s5-device__protocol">WatchConnectivity</div>
              <p>Biometric data never leaves the Watch-iPhone pair.</p>
            </div>
            <div class="s5-device s5-device--teal dk-reveal" style="transition-delay: 150ms">
              <div class="s5-device__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--teal)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6.5 6.5l11 11L12 23V1l5.5 5.5-11 11" />
                </svg>
              </div>
              <div class="s5-device__header">Garmin</div>
              <div class="s5-device__trust">On-device only</div>
              <div class="s5-device__protocol">BLE direct</div>
              <p>Raw data stays on the device; only relative descriptors transmitted.</p>
            </div>
            <div class="s5-device s5-device--blue dk-reveal" style="transition-delay: 300ms">
              <div class="s5-device__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9" />
                  <circle cx="12" cy="12" r="5" />
                </svg>
              </div>
              <div class="s5-device__header">Oura Ring</div>
              <div class="s5-device__trust">Client-side cloud</div>
              <div class="s5-device__protocol">REST API + OAuth</div>
              <p>Cloud data pulled to phone, processed locally, never re-uploaded.</p>
            </div>
          </div>
          <div class="s5-convergence dk-reveal" style="transition-delay: 400ms">
            All paths converge through relative descriptor functions — the AI sees patterns, never raw biometrics.
          </div>
        </div>
      </section>

      <!-- Slide 6: The Market -->
      <section class="slide" id="slide-6" aria-label="The Market">
        <div class="slide__inner">
          <div class="slide-eyebrow dk-reveal" style="text-align: center">THE MARKET</div>
          <h2 class="slide-heading dk-reveal" style="text-align: center">Three categories. None connect all three layers.</h2>
          <div class="notice-island-wrap">
            <NoticeCompetitiveGap client:visible />
          </div>
          <div class="s6-callouts">
            <div class="s6-callout dk-reveal" style="transition-delay: 250ms">
              <strong>Multi-device moat</strong>
              <p>WHOOP reads only WHOOP. Oura reads only Oura. Notice reads all three — and builds a unified awareness layer on top.</p>
            </div>
            <div class="s6-callout dk-reveal" style="transition-delay: 400ms">
              <strong>Pricing anchor</strong>
              <p>Core: $80/yr (AI reflection limited). Full: $149–199/yr (unlimited AI, multi-device). Positioned between meditation apps (~$70) and health trackers (~$200).</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Slide 7: The Moat -->
      <section class="slide" id="slide-7" aria-label="The Moat">
        <div class="slide__inner">
          <div class="slide-eyebrow dk-reveal">THE MOAT DEEPENS</div>
          <h2 class="slide-heading dk-reveal">On-device personalization + an app that grows with the user.</h2>
          <div class="s7-grid">
            <div class="s7-dark dk-reveal" style="transition-delay: 100ms">
              <h3>On-Device AI</h3>
              <ul>
                <li>Apple Foundation Models for real-time reflection</li>
                <li>LoRA fine-tuning on personal patterns</li>
                <li>Contemplative vocabulary &rarr; not generic wellness</li>
                <li>Runs on Apple Neural Engine</li>
                <li>No cloud dependency for core loop</li>
                <li>Privacy by architecture, not policy</li>
                <li>Training data never leaves the device</li>
              </ul>
            </div>
            <div class="s7-light dk-reveal" style="transition-delay: 250ms">
              <h3>Expanding Vision</h3>
              <div class="s7-phase s7-phase--green">
                <strong>Now</strong>
                <span>Apple Watch + iPhone core loop. Garmin + Oura integration.</span>
              </div>
              <div class="s7-phase s7-phase--gold">
                <strong>Next</strong>
                <span>On-device LoRA. Longitudinal pattern detection. Therapist dashboard.</span>
              </div>
              <div class="s7-phase s7-phase--teal">
                <strong>Later</strong>
                <span>Research partnerships. Peer-reviewed ILT validation. Platform API for contemplative apps.</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Slide 8: Team + Close -->
      <section class="slide slide--dark" id="slide-8" aria-label="Team and Close">
        <div class="slide__inner">
          <img src="/images/enso-transparent.png" alt="" class="s8-enso dk-reveal" width="64" height="64" />
          <h2 class="s8-title dk-reveal">Thomas Brady</h2>
          <div class="s8-role dk-reveal">Solo founder &middot; Pando Industries</div>
          <div class="s8-grid">
            <div class="s8-card dk-reveal" style="transition-delay: 0ms">
              <strong>Product + AI</strong>
              <span>8 years shipping AI products. AWS, H2O.ai, startups. Frontier AI &amp; infrastructure at scale.</span>
            </div>
            <div class="s8-card dk-reveal" style="transition-delay: 150ms">
              <strong>Special Forces</strong>
              <span>U.S. Army Special Forces (Green Beret). Systems thinking under uncertainty. Building teams that operate autonomously.</span>
            </div>
            <div class="s8-card dk-reveal" style="transition-delay: 300ms">
              <strong>Contemplative Practice</strong>
              <span>Therav&#257;da + Vajray&#257;na. 10+ years. Notice comes from practice, not market research.</span>
            </div>
            <div class="s8-card dk-reveal" style="transition-delay: 450ms">
              <strong>Builder</strong>
              <span>AI research (Scholion &amp; Learned Compilation), Notice, Absolute Beginners++, and thbrdy.dev (this site). Every project makes invisible structures visible and navigable.</span>
            </div>
          </div>
          <div class="s8-contact dk-reveal" style="transition-delay: 600ms">
            thbrdy@pando.industries &middot; notice.tools
          </div>
        </div>
      </section>

    </div>

    <nav class="deck-nav" id="deck-nav" aria-label="Slide navigation">
      <span class="deck-nav__counter" id="deck-counter" aria-live="polite">1 / 8</span>
    </nav>
  </div>
</Base>

<style is:global>
  html.deck-mode {
    overflow: hidden;
  }
  html.deck-mode body {
    overflow: hidden;
  }
</style>

<style>
  /* ── Layout ── */
  .deck-page {
    display: flex;
    flex-direction: column;
    height: 100vh;
    padding-top: 60px; /* clear fixed nav */
  }

  .deck-header {
    flex-shrink: 0;
    padding: 0.75rem 2rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .deck-header__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .deck-header__left {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .deck-header__eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    color: var(--accent);
    text-transform: uppercase;
  }

  .deck-header__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text);
  }

  .deck-header__right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .deck-header__link {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .deck-header__link:hover {
    color: var(--accent);
  }

  .deck-header__sep {
    color: var(--text-faint);
    font-size: 0.65rem;
  }

  /* ── Deck scroll container ── */
  .deck {
    flex: 1;
    overflow-y: auto;
    scroll-snap-type: y mandatory;
    position: relative;
    scroll-behavior: smooth;
  }

  /* ── Slides ── */
  .slide {
    min-height: 100vh;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 4rem 2rem 3rem;
    background: var(--bg);
    color: var(--text);
  }

  .slide--dark {
    background: var(--bg-dark);
    color: var(--bg);
  }

  .slide__inner {
    max-width: 1100px;
    width: 100%;
  }

  /* ── Shared typography ── */
  .slide-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .slide-heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 2rem;
    color: var(--text);
  }

  /* ── Reveal animation ── */
  .dk-reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .dk-reveal.dk-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Deck nav ── */
  .deck-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding: 0.75rem;
    pointer-events: none;
  }

  .deck-nav__counter {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    color: var(--text-muted);
    background: rgba(250, 246, 240, 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 0.35rem 1rem;
    border-radius: 4px;
    border: 1px solid var(--border);
    pointer-events: auto;
  }

  /* ── Slide 1: Title ── */
  .slide#slide-1 .slide__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .s1-enso {
    margin-bottom: 1.5rem;
    opacity: 0.85;
  }

  .s1-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 400;
    line-height: 1;
    margin-bottom: 1.25rem;
    color: var(--bg);
  }

  .s1-tagline {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.1rem, 2.5vw, 1.5rem);
    color: var(--text-faint);
    margin-bottom: 1rem;
    font-style: italic;
  }

  .s1-subtitle {
    font-family: 'DM Sans', sans-serif;
    font-size: clamp(0.8rem, 1.5vw, 1rem);
    color: var(--text-muted);
    margin-bottom: 3rem;
  }

  .s1-contact {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  /* ── Slide 2: The Gap ── */
  .s2-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .s2-card {
    background: var(--bg-card);
    border-left: 3px solid var(--accent);
    padding: 1.25rem 1.5rem;
    border-radius: 4px;
  }

  .s2-card strong {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    display: block;
    margin-bottom: 0.4rem;
    color: var(--text);
  }

  .s2-card span {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.95rem;
    color: var(--text-light);
    line-height: 1.5;
  }

  .s2-insight {
    background: var(--bg-dark);
    color: var(--bg);
    padding: 2rem;
    border-radius: 6px;
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  .s2-insight p {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.15rem;
    font-style: italic;
    line-height: 1.6;
  }

  /* ── Island wrapper ── */
  .notice-island-wrap {
    max-width: 780px;
    margin: 0 auto;
    width: 100%;
  }

  /* ── Slide 3: The Product ── */
  .s3-features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    background: var(--bg-warm);
    padding: 1.25rem 1.5rem;
    border-radius: 6px;
  }

  .s3-feature strong {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    display: block;
    margin-bottom: 0.25rem;
    color: var(--text);
  }

  .s3-feature span {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.85rem;
    color: var(--text-light);
  }

  /* ── Slide 4: Novel Metric ── */
  .s4-callout {
    background: var(--bg-dark);
    color: var(--bg);
    padding: 1.5rem 2rem;
    border-radius: 6px;
    text-align: center;
  }

  .s4-callout p {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.05rem;
    font-style: italic;
    line-height: 1.5;
  }

  /* ── Slide 5: Privacy as Topology ── */
  .s5-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .s5-device {
    background: var(--bg-card);
    border-radius: 6px;
    padding: 1.5rem;
    border-top: 3px solid var(--accent);
  }

  .s5-device--green { border-top-color: var(--green); }
  .s5-device--teal  { border-top-color: var(--teal); }
  .s5-device--blue  { border-top-color: var(--blue); }

  .s5-device__icon {
    text-align: center;
    margin-bottom: 0.75rem;
  }

  .s5-device__header {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--text);
  }

  .s5-device__trust {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.25rem;
  }

  .s5-device__protocol {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .s5-device p {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.9rem;
    color: var(--text-light);
    line-height: 1.5;
  }

  .s5-convergence {
    background: var(--bg-warm);
    padding: 1.25rem 2rem;
    border-radius: 6px;
    text-align: center;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    font-style: italic;
    color: var(--text-light);
    line-height: 1.5;
  }

  /* ── Slide 6: The Market ── */
  .s6-callouts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .s6-callout {
    background: var(--bg-card);
    border-radius: 6px;
    padding: 1.5rem;
  }

  .s6-callout strong {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    display: block;
    margin-bottom: 0.5rem;
    color: var(--text);
  }

  .s6-callout p {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.9rem;
    color: var(--text-light);
    line-height: 1.5;
  }

  /* ── Slide 7: The Moat ── */
  .s7-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .s7-dark {
    background: var(--bg-dark);
    color: var(--bg);
    padding: 2rem;
    border-radius: 8px;
  }

  .s7-dark h3 {
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
    color: var(--bg);
  }

  .s7-dark ul {
    list-style: none;
    padding: 0;
  }

  .s7-dark li {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.9rem;
    line-height: 1.5;
    padding: 0.4rem 0;
    padding-left: 1.25rem;
    position: relative;
    color: var(--text-faint);
  }

  .s7-dark li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.85rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .s7-light {
    background: var(--bg-card);
    padding: 2rem;
    border-radius: 8px;
  }

  .s7-light h3 {
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
    color: var(--text);
  }

  .s7-phase {
    padding: 1rem 1.25rem;
    margin-bottom: 0.75rem;
    border-radius: 4px;
    border-left: 3px solid var(--accent);
    background: var(--bg);
  }

  .s7-phase--green { border-left-color: var(--green); }
  .s7-phase--gold  { border-left-color: var(--accent); }
  .s7-phase--teal  { border-left-color: var(--teal); }

  .s7-phase strong {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    display: block;
    margin-bottom: 0.25rem;
    color: var(--text);
  }

  .s7-phase span {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.85rem;
    color: var(--text-light);
    line-height: 1.4;
  }

  /* ── Slide 8: Team + Close ── */
  .slide#slide-8 .slide__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .s8-enso {
    margin-bottom: 1.25rem;
    opacity: 0.85;
  }

  .s8-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 400;
    line-height: 1.1;
    margin-bottom: 0.5rem;
    color: var(--bg);
  }

  .s8-role {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 2.5rem;
  }

  .s8-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    max-width: 800px;
    width: 100%;
    margin-bottom: 2.5rem;
    text-align: left;
  }

  .s8-card {
    background: var(--bg-dark-mid);
    padding: 1.25rem 1.5rem;
    border-radius: 6px;
  }

  .s8-card strong {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    display: block;
    margin-bottom: 0.4rem;
    color: var(--bg);
  }

  .s8-card span {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.85rem;
    color: var(--text-faint);
    line-height: 1.5;
