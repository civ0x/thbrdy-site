  .s8-contact {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  /* ── Island margin overrides for deck context ── */
  .notice-island-wrap :global(.notice-flow) {
    margin: 0;
  }

  .notice-island-wrap :global(.nvlt-root) {
    margin: 0 auto;
  }

  .notice-island-wrap :global(.notice-gap) {
    margin: 0;
  }

  .notice-island-wrap :global(.notice-gap-header) {
    display: none;
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .dk-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .deck {
      scroll-behavior: auto;
    }
  }

  /* ── Responsive: Tablet ── */
  @media (max-width: 900px) {
    .deck-page {
      height: auto;
      padding-top: 50px;
    }

    .deck {
      overflow: visible;
      scroll-snap-type: none;
      scroll-behavior: auto;
    }

    .slide {
      min-height: auto;
      scroll-snap-align: unset;
      padding: 4rem 1.5rem;
    }

    .deck-nav {
      display: none;
    }

    .s2-cards,
    .s6-callouts,
    .s7-grid,
    .s8-grid {
      grid-template-columns: 1fr;
    }

    .s5-cards {
      grid-template-columns: 1fr;
    }
  }

  /* ── Responsive: Phone ── */
  @media (max-width: 640px) {
    .deck-header {
      padding: 0.5rem 1rem;
    }

    .deck-header__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }

    .slide {
      padding: 3rem 1.25rem;
    }

    .slide-heading {
      margin-bottom: 1.5rem;
    }

    .s3-features {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const deck = document.getElementById('deck');
  const slides = deck?.querySelectorAll('.slide');
  const counter = document.getElementById('deck-counter');
  const isMobile = () => window.matchMedia('(max-width: 900px)').matches;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Add deck-mode class on desktop to prevent page scroll
  function updateDeckMode() {
    if (!isMobile()) {
      document.documentElement.classList.add('deck-mode');
    } else {
      document.documentElement.classList.remove('deck-mode');
    }
  }
  updateDeckMode();
  window.addEventListener('resize', updateDeckMode);

  // Track current slide
  let current = 0;

  // Keyboard navigation (desktop only)
  const scrollBehavior = prefersReducedMotion ? 'auto' : 'smooth';

  document.addEventListener('keydown', (e) => {
    if (isMobile() || !slides) return;
    if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
      e.preventDefault();
      current = Math.min(current + 1, slides.length - 1);
      slides[current].scrollIntoView({ behavior: scrollBehavior, block: 'start' });
    } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
      e.preventDefault();
      current = Math.max(current - 1, 0);
      slides[current].scrollIntoView({ behavior: scrollBehavior, block: 'start' });
    }
  });

  // Slide counter via IntersectionObserver
  if (slides && counter) {
    const slideObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          current = [...slides].indexOf(entry.target as Element);
          counter.textContent = `${current + 1} / ${slides.length}`;
        }
      });
    }, { root: deck, threshold: 0.5 });
    slides.forEach(s => slideObserver.observe(s));
  }

  // Reveal animation via IntersectionObserver
  const revealElements = document.querySelectorAll('.dk-reveal');
  if (prefersReducedMotion) {
    revealElements.forEach(el => el.classList.add('dk-revealed'));
  } else {
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).classList.add('dk-revealed');
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    revealElements.forEach(el => revealObserver.observe(el));
  }
</script>
