---
interface Props {
  current?: 'hub' | 'vision' | 'build' | 'roadmap' | 'deck' | 'brief';
}

const { current = 'hub' } = Astro.props;

const pages = [
  { id: 'vision', label: 'Vision', href: '/notice/vision/' },
  { id: 'build', label: 'Build', href: '/writing/notice/' },
  { id: 'roadmap', label: 'Roadmap', href: '/notice/roadmap/' },
  { id: 'deck', label: 'Deck', href: '/notice/deck/' },
  { id: 'brief', label: 'Brief', href: '/notice/brief/' },
];

const isHub = current === 'hub';
const navLinks = isHub ? pages : pages.filter(p => p.id !== current);
---

<nav class="notice-hub-nav" aria-label="Notice section navigation">
  <div class="notice-hub-nav__inner">
    <div class="notice-hub-nav__left">
      {isHub ? (
        <span class="notice-hub-nav__eyebrow">NOTICE</span>
      ) : (
        <a href="/notice/" class="notice-hub-nav__eyebrow notice-hub-nav__eyebrow--link">NOTICE</a>
      )}
    </div>
    <div class="notice-hub-nav__right">
      {navLinks.map((page, i) => (
        <>
          {i > 0 && <span class="notice-hub-nav__sep">&middot;</span>}
          <a href={page.href} class="notice-hub-nav__link">{page.label}</a>
        </>
      ))}
    </div>
  </div>
</nav>

<style>
  .notice-hub-nav {
    padding: 0.75rem 2rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .notice-hub-nav__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .notice-hub-nav__left {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .notice-hub-nav__eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    color: var(--accent);
    text-transform: uppercase;
  }

  .notice-hub-nav__eyebrow--link {
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .notice-hub-nav__eyebrow--link:hover {
    opacity: 0.7;
  }

  .notice-hub-nav__right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .notice-hub-nav__link {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .notice-hub-nav__link:hover {
    color: var(--accent);
  }

  .notice-hub-nav__sep {
    color: var(--text-faint);
    font-size: 0.65rem;
  }

  @media (max-width: 640px) {
    .notice-hub-nav {
      padding: 0.5rem 1rem;
    }

    .notice-hub-nav__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .notice-hub-nav__link,
    .notice-hub-nav__eyebrow--link {
      transition: none;
    }
  }
</style>
