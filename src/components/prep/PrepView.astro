---
import Base from '../../layouts/Base.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { marked } from 'marked';

interface Props {
  selectedStory: CollectionEntry<'stories'>;
  linkPrefix: string;
}

const { selectedStory, linkPrefix } = Astro.props;

const stories = await getCollection('stories');

const corpus = stories.map((s) => ({
  id: s.id,
  href: `${linkPrefix}${s.id}/`,
  project: s.data.project,
  shape: s.data.shape,
  tagline: s.data.tagline,
  questions: s.data.questions,
  handles: s.data.handles,
}));

const uniqueProjects = Array.from(
  new Set(corpus.map((s) => s.project))
).sort();
const uniqueShapes = Array.from(
  new Set(corpus.map((s) => s.shape))
).sort();

const corpusByProject = uniqueProjects.reduce<Record<string, typeof corpus>>(
  (acc, p) => {
    acc[p] = corpus
      .filter((s) => s.project === p)
      .slice()
      .sort((a, b) => a.tagline.localeCompare(b.tagline));
    return acc;
  },
  {}
);

const ribbonInitial = corpus
  .slice()
  .sort((a, b) => a.tagline.localeCompare(b.tagline))
  .slice(0, 5);

function splitBody(body: string): {
  rendered: Record<string, string>;
  raw: Record<string, string>;
} {
  const rendered: Record<string, string> = {};
  const raw: Record<string, string> = {};
  const regex = /^## (.+?)$\n([\s\S]*?)(?=^## |$(?![\s\S]))/gm;
  let match;
  while ((match = regex.exec(body)) !== null) {
    const name = match[1].trim();
    const text = match[2].trim();
    raw[name] = text;
    rendered[name] = marked.parse(text) as string;
  }
  return { rendered, raw };
}

const { rendered: sections, raw: rawSections } = splitBody(selectedStory.body ?? '');
const orientation = sections['Project orientation'] ?? '';
const opener = sections['Opener'] ?? '';
const punchline = sections['Punchline'] ?? '';
const arcBeats = sections['Arc beats'] ?? '';
const verify = sections['Verify'] ?? '';

const rawOrientation = rawSections['Project orientation'] ?? '';
const rawOpener = rawSections['Opener'] ?? '';
const rawPunchline = rawSections['Punchline'] ?? '';
const rawArcBeats = rawSections['Arc beats'] ?? '';
const rawVerify = rawSections['Verify'] ?? '';

const isDev = import.meta.env.DEV;

const corpusJson = JSON.stringify(corpus).replace(/</g, '\\u003c');
---

<Base
  title={`${selectedStory.data.tagline} — Prep`}
  description={selectedStory.data.tagline}
>
  <section class="prep">
    <form class="prep__search" role="search" onsubmit="return false;">
      <label class="prep__search-label" for="prep-search-input">Search stories</label>
      <input
        id="prep-search-input"
        class="prep__search-input"
        type="search"
        inputmode="search"
        enterkeyhint="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="Type a question, a tagline, or a handle…"
        aria-controls="prep-ribbon"
        aria-autocomplete="list"
      />
      <p id="prep-search-status" class="prep__search-status" aria-live="polite">
        Top {ribbonInitial.length} alphabetical
      </p>
    </form>

    <details class="prep__portfolio">
      <summary class="prep__portfolio-summary">
        <span class="prep__portfolio-summary-label" id="prep-portfolio-label">Portfolio</span>
        <span class="prep__portfolio-summary-gaps" id="prep-portfolio-summary-gaps"></span>
      </summary>
      <div class="prep__portfolio-body">
        <nav
          id="prep-portfolio-picker"
          class="prep__portfolio-picker"
          aria-label="Saved portfolios"
        >
          <!-- pills rendered at runtime -->
        </nav>

        <label class="prep__portfolio-field">
          <span class="prep__portfolio-field-label">Loop name</span>
          <input
            id="prep-portfolio-name"
            type="text"
            class="prep__portfolio-name"
            placeholder="e.g., Onebrief 2026-05-20"
            autocomplete="off"
          />
        </label>

        <div class="prep__portfolio-coverage">
          <p class="prep__portfolio-coverage-summary" id="prep-portfolio-coverage-summary">
            Coverage: 0 of 0 questions
          </p>
          <details class="prep__portfolio-gaps">
            <summary class="prep__portfolio-gaps-summary">
              Uncovered questions
              <span class="prep__portfolio-gaps-count" id="prep-portfolio-gaps-count"></span>
            </summary>
            <ul class="prep__portfolio-gaps-list" id="prep-portfolio-gaps-list"></ul>
          </details>
        </div>

        <fieldset class="prep__portfolio-fieldset">
          <legend class="prep__portfolio-fieldset-legend">Stories in this portfolio</legend>
          <div class="prep__portfolio-tree">
            {uniqueProjects.map((project) => (
              <details class="prep__portfolio-tree-group" data-project={project} open>
                <summary class="prep__portfolio-tree-group-summary">
                  <span class="prep__portfolio-tree-group-name">{project}</span>
                  <span
                    class="prep__portfolio-tree-group-counts"
                    id={`prep-tree-counts-${project}`}
                  >0 / {corpusByProject[project].length}</span>
                </summary>
                <ul class="prep__portfolio-tree-stories">
                  {corpusByProject[project].map((s) => (
                    <li class="prep__portfolio-tree-story">
                      <input
                        type="checkbox"
                        class="prep__portfolio-checkbox"
                        data-story-id={s.id}
                        aria-label={`Include ${s.tagline} in portfolio`}
                      />
                      <a
                        class="prep__portfolio-tree-story-link"
                        href={s.href}
                        data-story-id={s.id}
                      >
                        <span class="prep__portfolio-tree-story-tagline">{s.tagline}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ))}
          </div>
        </fieldset>

        <div class="prep__portfolio-actions">
          <button id="prep-portfolio-save" class="prep__portfolio-button" type="button">
            Save portfolio
          </button>
          <button
            id="prep-portfolio-delete"
            class="prep__portfolio-button prep__portfolio-button--secondary"
            type="button"
          >
            Delete
          </button>
        </div>
      </div>
    </details>

    <div class="prep__chips" id="prep-chips" aria-label="Filter by project or shape">
      {uniqueProjects.map((p) => (
        <button
          type="button"
          class="prep__chip prep__chip--project"
          data-facet="project"
          data-value={p}
          aria-pressed="false"
        >
          <span class="prep__chip-sigil">@</span>{p}
        </button>
      ))}
      {uniqueShapes.map((sh) => (
        <button
          type="button"
          class="prep__chip prep__chip--shape"
          data-facet="shape"
          data-value={sh}
          aria-pressed="false"
        >
          <span class="prep__chip-sigil">#</span>{sh}
        </button>
      ))}
    </div>

    <nav
      id="prep-ribbon"
      class="prep__ribbon"
      role="listbox"
      aria-label="Story ribbon"
    >
      {ribbonInitial.map((s, idx) => (
        <a
          href={s.href}
          id={`prep-ribbon-${s.id}`}
          class={`prep__ribbon-item ${s.id === selectedStory.id ? 'prep__ribbon-item--selected' : ''}`}
          data-story-id={s.id}
          role="option"
          aria-selected={s.id === selectedStory.id ? 'true' : 'false'}
          tabindex={idx === 0 ? 0 : -1}
        >
          <span class="prep__ribbon-project">{s.project}</span>
          <span class="prep__ribbon-tagline">{s.tagline}</span>
        </a>
      ))}
    </nav>

    <article class="prep__focus" data-story-id={selectedStory.id}>
      <nav
        id="prep-tabs"
        class="prep__tabs"
        aria-label="Portfolio story tabs"
        hidden
      ></nav>
      <header class="prep__focus-header">
        <div class="prep__focus-tags">
          <span class="prep__tag prep__tag--project">{selectedStory.data.project}</span>
          <span class="prep__tag">{selectedStory.data.shape}</span>
          <span class="prep__tag">{selectedStory.data.agentRelevance}</span>
          {isDev && (
            <button
              type="button"
              class="prep__edit-pill"
              id="prep-edit-pill"
              aria-pressed="false"
              title="Toggle edit mode (Cmd/Ctrl+E)"
            >EDIT</button>
          )}
        </div>
        <h1 class="prep__focus-tagline" data-edit-field="tagline">{selectedStory.data.tagline}</h1>
        <button
          id="prep-mode-toggle"
          class="prep__mode-toggle"
          type="button"
          aria-pressed="false"
          aria-label="Toggle deploy or drilling mode"
        >
          <span class="prep__mode-label" data-deploy-label="Deploy" data-drilling-label="Drilling">Deploy</span>
        </button>
      </header>

      {isDev && (
        <section class="prep__edit-frontmatter" aria-label="Story metadata (edit mode)">
          <div class="prep__edit-block">
            <p class="prep__edit-label">Questions</p>
            <ul class="prep__edit-list" data-edit-field="questions">
              {selectedStory.data.questions.map((q, i) => (
                <li data-index={i}>{q}</li>
              ))}
            </ul>
          </div>
        </section>
      )}

      <section class="prep__above" aria-label="Deploy content">
        <div class="prep__cue prep__cue--orientation">
          <p class="prep__cue-label">Project · {selectedStory.data.project}</p>
          <div class="prep__prose" set:html={orientation} />
          {isDev && (
            <textarea
              class="prep__edit-textarea"
              data-edit-field="section"
              data-section-name="Project orientation"
              spellcheck="false"
            >{rawOrientation}</textarea>
          )}
        </div>

        <div class="prep__verbatim prep__verbatim--opener">
          <p class="prep__verbatim-label">Opener</p>
          <div class="prep__prose" set:html={opener} />
          {isDev && (
            <textarea
              class="prep__edit-textarea"
              data-edit-field="section"
              data-section-name="Opener"
              spellcheck="false"
            >{rawOpener}</textarea>
          )}
        </div>

        <div class="prep__verbatim prep__verbatim--punchline">
          <p class="prep__verbatim-label">Punchline</p>
          <div class="prep__prose" set:html={punchline} />
          {isDev && (
            <textarea
              class="prep__edit-textarea"
              data-edit-field="section"
              data-section-name="Punchline"
              spellcheck="false"
            >{rawPunchline}</textarea>
          )}
        </div>
      </section>

      <details class="prep__details prep__details--beats">
        <summary class="prep__summary">Arc beats &amp; handles</summary>
        <div class="prep__details-body">
          <div class="prep__cue">
            <p class="prep__cue-label">Arc beats</p>
            <div class="prep__prose" set:html={arcBeats} />
            {isDev && (
              <textarea
                class="prep__edit-textarea"
                data-edit-field="section"
                data-section-name="Arc beats"
                spellcheck="false"
              >{rawArcBeats}</textarea>
            )}
          </div>
          <div class="prep__cue">
            <p class="prep__cue-label">Handles</p>
            <ul class="prep__handles" data-edit-field="handles">
              {selectedStory.data.handles.map((h, i) => <li data-index={i}>{h}</li>)}
            </ul>
          </div>
        </div>
      </details>

      <details class="prep__details prep__details--verify">
        <summary class="prep__summary">Verify items</summary>
        <div class="prep__details-body">
          <div class="prep__cue prep__cue--verify">
            <div class="prep__prose" set:html={verify} />
            {isDev && (
              <textarea
                class="prep__edit-textarea"
                data-edit-field="section"
                data-section-name="Verify"
                spellcheck="false"
              >{rawVerify}</textarea>
            )}
          </div>
        </div>
      </details>
    </article>
  </section>
</Base>

<script type="application/json" id="prep-corpus" is:inline set:html={corpusJson}></script>

<script>
  import Fuse from 'fuse.js';

  type Entry = {
    id: string;
    href: string;
    project: string;
    shape: string;
    tagline: string;
    questions: string[];
    handles: string[];
  };

  type Frecency = { [id: string]: number[] };

  type QueryFrecency = { [query: string]: { [storyId: string]: number[] } };

  type Portfolio = {
    id: string;
    name: string;
    storyIds: string[];
    updatedAt: number;
    createdAt: number;
  };

  type PortfoliosState = {
    items: Portfolio[];
    activeId: string | null;
  };

  type VerifyState = {
    [storyId: string]: { [itemKey: string]: number };
  };

  const HALF_LIFE_MS = 14 * 24 * 3600 * 1000;
  const PRUNE_BEFORE_MS = 6 * HALF_LIFE_MS;
  const ALPHA = 0.5;
  const BETA = 1.0;
  const FRECENCY_KEY = 'prep:v1:frecency';
  const QUERY_FRECENCY_KEY = 'prep:v1:query_frecency';
  const MODE_KEY = 'prep:v1:mode';
  const PORTFOLIO_KEY = 'prep:v1:portfolio'; // legacy single-portfolio key (migrated)
  const PORTFOLIOS_KEY = 'prep:v1:portfolios';
  const VERIFY_KEY = 'prep:v1:verify';
  const EDIT_MODE_KEY = 'prep:v1:editMode';
  const TREE_OPEN_KEY = 'prep:v1:tree_open';
  const SCHEMA_KEY = 'prep:v1:_schema_version';

  const DEV = import.meta.env.DEV;

  const corpus: Entry[] = JSON.parse(
    document.getElementById('prep-corpus')!.textContent!
  );

  const fuse = new Fuse(corpus, {
    keys: [
      { name: 'questions', weight: 0.6 },
      { name: 'handles', weight: 0.2 },
      { name: 'tagline', weight: 0.2 },
    ],
    includeScore: true,
    threshold: 0.4,
    ignoreLocation: true,
    minMatchCharLength: 2,
  });

  const input = document.getElementById('prep-search-input') as HTMLInputElement;
  const ribbon = document.getElementById('prep-ribbon') as HTMLElement;
  const status = document.getElementById('prep-search-status') as HTMLElement;
  const focusPane = document.querySelector('.prep__focus') as HTMLElement;
  const selectedStoryId = focusPane.dataset.storyId!;

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function readFrecency(): Frecency {
    try {
      const raw = localStorage.getItem(FRECENCY_KEY);
      return raw ? (JSON.parse(raw) as Frecency) : {};
    } catch {
      return {};
    }
  }

  function writeFrecency(frec: Frecency): void {
    try {
      localStorage.setItem(FRECENCY_KEY, JSON.stringify(frec));
      if (!localStorage.getItem(SCHEMA_KEY)) {
        localStorage.setItem(SCHEMA_KEY, '1');
      }
    } catch {}
  }

  function normalizeQuery(q: string): string {
    return q.trim().toLowerCase();
  }

  function readQueryFrecency(): QueryFrecency {
    try {
      const raw = localStorage.getItem(QUERY_FRECENCY_KEY);
      return raw ? (JSON.parse(raw) as QueryFrecency) : {};
    } catch {
      return {};
    }
  }

  function writeQueryFrecency(state: QueryFrecency): void {
    try {
      if (Object.keys(state).length === 0) {
        localStorage.removeItem(QUERY_FRECENCY_KEY);
        return;
      }
      localStorage.setItem(QUERY_FRECENCY_KEY, JSON.stringify(state));
      if (!localStorage.getItem(SCHEMA_KEY)) {
        localStorage.setItem(SCHEMA_KEY, '1');
      }
    } catch {}
  }

  function recordQueryClick(rawQuery: string, storyId: string): void {
    const q = normalizeQuery(rawQuery);
    if (q.length < 2) return; // align with fuse minMatchCharLength
    const now = Date.now();
    const state = readQueryFrecency();
    const bucket = state[q] ?? {};
    const existing = (bucket[storyId] || []).filter(
      (t) => t > now - PRUNE_BEFORE_MS
    );
    existing.push(now);
    bucket[storyId] = existing;
    state[q] = bucket;
    // Prune entire query entries where no story has any live timestamps.
    for (const key of Object.keys(state)) {
      const sub = state[key];
      let hasLive = false;
      for (const ids of Object.values(sub)) {
        if (ids.some((t) => t > now - PRUNE_BEFORE_MS)) {
          hasLive = true;
          break;
        }
      }
      if (!hasLive) delete state[key];
    }
    writeQueryFrecency(state);
  }

  function genPortfolioId(): string {
    // Cheap stable-ish ID; collision risk negligible at single-user scale.
    return `p_${Date.now().toString(36)}_${Math.random().toString(36).slice(2, 8)}`;
  }

  function readPortfolios(): PortfoliosState {
    try {
      // One-shot migration: legacy single-portfolio → multi-portfolio shape.
      const legacy = localStorage.getItem(PORTFOLIO_KEY);
      const current = localStorage.getItem(PORTFOLIOS_KEY);
      if (legacy && !current) {
        try {
          const old = JSON.parse(legacy) as Portfolio;
          if (
            old &&
            typeof old.name === 'string' &&
            Array.isArray(old.storyIds) &&
            typeof old.updatedAt === 'number'
          ) {
            const migrated: Portfolio = {
              id: genPortfolioId(),
              name: old.name,
              storyIds: old.storyIds,
              updatedAt: old.updatedAt,
              createdAt: old.updatedAt,
            };
            const state: PortfoliosState = {
              items: [migrated],
              activeId: migrated.id,
            };
            localStorage.setItem(PORTFOLIOS_KEY, JSON.stringify(state));
            localStorage.removeItem(PORTFOLIO_KEY);
          } else {
            localStorage.removeItem(PORTFOLIO_KEY);
          }
        } catch {
          localStorage.removeItem(PORTFOLIO_KEY);
        }
      }

      const raw = localStorage.getItem(PORTFOLIOS_KEY);
      if (!raw) return { items: [], activeId: null };
      const parsed = JSON.parse(raw) as PortfoliosState;
      if (!parsed || !Array.isArray(parsed.items)) {
        return { items: [], activeId: null };
      }
      const validIds = new Set(corpus.map((e) => e.id));
      const items: Portfolio[] = [];
      for (const p of parsed.items) {
        if (
          !p ||
          typeof p.id !== 'string' ||
          typeof p.name !== 'string' ||
          !Array.isArray(p.storyIds) ||
          typeof p.updatedAt !== 'number'
        ) continue;
        const filtered = p.storyIds.filter((id) => validIds.has(id));
        if (filtered.length === 0) continue;
        items.push({
          ...p,
          storyIds: filtered,
          createdAt: typeof p.createdAt === 'number' ? p.createdAt : p.updatedAt,
        });
      }
      const validActiveIds = new Set(items.map((p) => p.id));
      const activeId =
        typeof parsed.activeId === 'string' && validActiveIds.has(parsed.activeId)
          ? parsed.activeId
          : null;
      return { items, activeId };
    } catch {
      return { items: [], activeId: null };
    }
  }

  function writePortfolios(state: PortfoliosState): void {
    try {
      if (state.items.length === 0) {
        localStorage.removeItem(PORTFOLIOS_KEY);
        return;
      }
      localStorage.setItem(PORTFOLIOS_KEY, JSON.stringify(state));
      if (!localStorage.getItem(SCHEMA_KEY)) {
        localStorage.setItem(SCHEMA_KEY, '1');
      }
    } catch {}
  }

  function readPortfolio(): Portfolio | null {
    // Façade: returns the active portfolio if one is set.
    const { items, activeId } = readPortfolios();
    if (!activeId) return null;
    return items.find((p) => p.id === activeId) ?? null;
  }

  function upsertPortfolio(
    id: string | null,
    name: string,
    storyIds: string[],
    activate: boolean
  ): string {
    const state = readPortfolios();
    const now = Date.now();
    if (id) {
      const existing = state.items.find((p) => p.id === id);
      if (existing) {
        existing.name = name;
        existing.storyIds = storyIds;
        existing.updatedAt = now;
      }
    } else {
      const newId = genPortfolioId();
      state.items.push({
        id: newId,
        name,
        storyIds,
        createdAt: now,
        updatedAt: now,
      });
      id = newId;
    }
    if (activate) state.activeId = id;
    writePortfolios(state);
    return id;
  }

  function deletePortfolio(id: string): void {
    const state = readPortfolios();
    state.items = state.items.filter((p) => p.id !== id);
    if (state.activeId === id) state.activeId = null;
    writePortfolios(state);
  }

  function setActivePortfolio(id: string | null): void {
    const state = readPortfolios();
    if (id !== null && !state.items.some((p) => p.id === id)) return;
    state.activeId = id;
    writePortfolios(state);
  }

  function itemKey(text: string): string {
    return text.trim().slice(0, 120);
  }

  function readVerify(
    currentItemsByStory: Record<string, string[]>
  ): VerifyState {
    try {
      const raw = localStorage.getItem(VERIFY_KEY);
      if (!raw) return {};
      const parsed = JSON.parse(raw) as VerifyState;
      if (!parsed || typeof parsed !== 'object') return {};
      const out: VerifyState = {};
      for (const [storyId, items] of Object.entries(parsed)) {
        if (!items || typeof items !== 'object') continue;
        const validSet = new Set(currentItemsByStory[storyId] ?? []);
        // Stories not in the lookup map are skipped (current view doesn't
        // know their item set). The state is preserved as-is on next write.
        if (!(storyId in currentItemsByStory)) {
          out[storyId] = items;
          continue;
        }
        const filtered: Record<string, number> = {};
        for (const [k, ts] of Object.entries(items)) {
          if (validSet.has(k) && typeof ts === 'number') filtered[k] = ts;
        }
        if (Object.keys(filtered).length > 0) out[storyId] = filtered;
      }
      return out;
    } catch {
      return {};
    }
  }

  function writeVerify(state: VerifyState): void {
    try {
      if (Object.keys(state).length === 0) {
        localStorage.removeItem(VERIFY_KEY);
        return;
      }
      localStorage.setItem(VERIFY_KEY, JSON.stringify(state));
      if (!localStorage.getItem(SCHEMA_KEY)) {
        localStorage.setItem(SCHEMA_KEY, '1');
      }
    } catch {}
  }

  function setVerifyItem(
    state: VerifyState,
    storyId: string,
    key: string,
    checked: boolean
  ): VerifyState {
    const next: VerifyState = { ...state };
    const story = { ...(next[storyId] ?? {}) };
    if (checked) {
      story[key] = Date.now();
    } else {
      delete story[key];
    }
    if (Object.keys(story).length === 0) {
      delete next[storyId];
    } else {
      next[storyId] = story;
    }
    return next;
  }

  function frecencyWeight(timestamps: number[] | undefined, now: number): number {
    if (!timestamps || timestamps.length === 0) return 0;
    return timestamps.reduce(
      (sum, t) => sum + Math.exp(-(now - t) / HALF_LIFE_MS),
      0
    );
  }

  function recordClick(id: string): void {
    const now = Date.now();
    const frec = readFrecency();
    const existing = (frec[id] || []).filter((t) => t > now - PRUNE_BEFORE_MS);
    existing.push(now);
    frec[id] = existing;
    writeFrecency(frec);
    // Also record query-specific click if the user clicked while searching.
    // Per-query frecency strengthens "type X → expect story Y" learning.
    const q = input.value;
    if (q.trim().length > 0) {
      recordQueryClick(q, id);
    }
  }

  function renderRibbon(entries: Entry[], statusText: string): void {
    if (entries.length === 0) {
      ribbon.innerHTML = '<p class="prep__ribbon-empty">No matches.</p>';
      status.textContent = statusText;
      input.removeAttribute('aria-activedescendant');
      return;
    }
    ribbon.innerHTML = entries
      .map((e, idx) => {
        const isSelected = e.id === selectedStoryId;
        return `<a
          href="${escapeHtml(e.href)}"
          id="prep-ribbon-${escapeHtml(e.id)}"
          class="prep__ribbon-item${isSelected ? ' prep__ribbon-item--selected' : ''}"
          data-story-id="${escapeHtml(e.id)}"
          role="option"
          aria-selected="${isSelected ? 'true' : 'false'}"
          tabindex="${idx === 0 ? '0' : '-1'}">
          <span class="prep__ribbon-project">${escapeHtml(e.project)}</span>
          <span class="prep__ribbon-tagline">${escapeHtml(e.tagline)}</span>
        </a>`;
      })
      .join('');
    status.textContent = statusText;
    selectedRibbonIndex = 0;
    applyRibbonSelection();
  }

  let selectedRibbonIndex = 0;

  function ribbonItems(): HTMLAnchorElement[] {
    return Array.from(ribbon.querySelectorAll<HTMLAnchorElement>('.prep__ribbon-item'));
  }

  function applyRibbonSelection(): void {
    const items = ribbonItems();
    if (items.length === 0) {
      input.removeAttribute('aria-activedescendant');
      return;
    }
    const idx = Math.max(0, Math.min(items.length - 1, selectedRibbonIndex));
    items.forEach((item, i) => {
      item.setAttribute('tabindex', i === idx ? '0' : '-1');
      // Keep visual "currently viewing" highlight separate from keyboard
      // selection: --selected stays on the current story; we use focus ring
      // for keyboard nav.
    });
    input.setAttribute('aria-activedescendant', items[idx].id);
    items[idx].scrollIntoView({ block: 'nearest', inline: 'nearest' });
    selectedRibbonIndex = idx;
  }

  function alphabetical(entries: Entry[]): Entry[] {
    return entries.slice().sort((a, b) => a.tagline.localeCompare(b.tagline));
  }

  // Chip filters: in-page state (not persisted; resets on navigation).
  // Within facet = OR; across facets = AND.
  const activeProjectChips = new Set<string>();
  const activeShapeChips = new Set<string>();

  function applyChipFilter(entries: Entry[]): Entry[] {
    if (activeProjectChips.size === 0 && activeShapeChips.size === 0) {
      return entries;
    }
    return entries.filter((e) => {
      const projectOk =
        activeProjectChips.size === 0 || activeProjectChips.has(e.project);
      const shapeOk =
        activeShapeChips.size === 0 || activeShapeChips.has(e.shape);
      return projectOk && shapeOk;
    });
  }

  function hasActiveChips(): boolean {
    return activeProjectChips.size > 0 || activeShapeChips.size > 0;
  }

  function byFrecency(entries: Entry[], frec: Frecency, now: number): Entry[] {
    return entries
      .map((e) => ({ entry: e, weight: frecencyWeight(frec[e.id], now) }))
      .sort((a, b) => {
        if (b.weight !== a.weight) return b.weight - a.weight;
        return a.entry.tagline.localeCompare(b.entry.tagline);
      })
      .map((x) => x.entry);
  }

  function hasAnyFrecency(frec: Frecency, now: number): boolean {
    return Object.values(frec).some((ts) => frecencyWeight(ts, now) > 0);
  }

  function update(): void {
    const now = Date.now();
    const frec = readFrecency();
    const portfolio = readPortfolio();
    const q = input.value.trim();

    if (q.length === 0) {
      const scopeSuffix = hasActiveChips() ? ' · scoped' : '';
      if (portfolio) {
        const ids = new Set(portfolio.storyIds);
        const portfolioCorpus = applyChipFilter(
          corpus.filter((e) => ids.has(e.id))
        );
        const top = byFrecency(portfolioCorpus, frec, now).slice(0, 5);
        const label =
          portfolio.name.trim().length > 0
            ? `Portfolio: ${portfolio.name}${scopeSuffix}`
            : `Portfolio (${portfolio.storyIds.length})${scopeSuffix}`;
        renderRibbon(top, label);
      } else if (hasAnyFrecency(frec, now)) {
        const top = byFrecency(applyChipFilter(corpus), frec, now).slice(0, 5);
        renderRibbon(top, `Top ${top.length} by recency${scopeSuffix}`);
      } else {
        const top = alphabetical(applyChipFilter(corpus)).slice(0, 5);
        renderRibbon(top, `Top ${top.length} alphabetical${scopeSuffix}`);
      }
      return;
    }

    const fuseResults = fuse.search(q);
    if (fuseResults.length === 0) {
      renderRibbon([], 'No matches.');
      return;
    }

    const queryFrec = readQueryFrecency();
    const queryBucket = queryFrec[normalizeQuery(q)] ?? {};

    const scopedItems = applyChipFilter(fuseResults.map((r) => r.item));
    const scopedIds = new Set(scopedItems.map((i) => i.id));
    const ranked = fuseResults
      .filter((r) => scopedIds.has(r.item.id))
      .map((r) => {
        const globalW = frecencyWeight(frec[r.item.id], now);
        const queryW = frecencyWeight(queryBucket[r.item.id], now);
        return {
          item: r.item,
          finalScore:
            (r.score ?? 1) / (1 + ALPHA * globalW + BETA * queryW),
        };
      })
      .sort((a, b) => a.finalScore - b.finalScore)
      .map((r) => r.item);

    if (ranked.length === 0) {
      renderRibbon([], 'No matches in current scope.');
      return;
    }

    const scopeSuffix = hasActiveChips() ? ' · scoped' : '';
    const top = ranked.slice(0, 5);
    renderRibbon(top, `${top.length} of ${ranked.length} matches${scopeSuffix}`);
  }

  // ============================================================
  // Mode toggle (Deploy / Drilling)
  // ============================================================
  const modeToggle = document.getElementById('prep-mode-toggle') as HTMLButtonElement;
  const modeLabel = modeToggle.querySelector('.prep__mode-label') as HTMLElement;
  const detailsEls = Array.from(
    document.querySelectorAll<HTMLDetailsElement>('.prep__details')
  );

  type Mode = 'deploy' | 'drilling';

  function readMode(): Mode {
    try {
      const v = localStorage.getItem(MODE_KEY);
      return v === 'drilling' ? 'drilling' : 'deploy';
    } catch {
      return 'deploy';
    }
  }

  function writeMode(m: Mode): void {
    try {
      localStorage.setItem(MODE_KEY, m);
    } catch {}
  }

  function applyMode(m: Mode): void {
    const isDrilling = m === 'drilling';
    modeToggle.setAttribute('aria-pressed', String(isDrilling));
    modeLabel.textContent = isDrilling
      ? modeLabel.dataset.drillingLabel!
      : modeLabel.dataset.deployLabel!;
    detailsEls.forEach((d) => {
      if (isDrilling) {
        d.setAttribute('open', '');
      } else {
        d.removeAttribute('open');
      }
    });
    document.body.dataset.prepMode = m;
  }

  modeToggle.addEventListener('click', () => {
    const next: Mode = readMode() === 'deploy' ? 'drilling' : 'deploy';
    writeMode(next);
    applyMode(next);
  });

  // ============================================================
  // Portfolio editor
  // ============================================================
  const portfolioDetails = document.querySelector(
    '.prep__portfolio'
  ) as HTMLDetailsElement;
  const portfolioLabel = document.getElementById('prep-portfolio-label')!;
  const portfolioName = document.getElementById(
    'prep-portfolio-name'
  ) as HTMLInputElement;
  const portfolioCheckboxes = Array.from(
    document.querySelectorAll<HTMLInputElement>('.prep__portfolio-checkbox')
  );
  const portfolioSave = document.getElementById(
    'prep-portfolio-save'
  ) as HTMLButtonElement;
  const portfolioDelete = document.getElementById(
    'prep-portfolio-delete'
  ) as HTMLButtonElement;
  const portfolioPicker = document.getElementById(
    'prep-portfolio-picker'
  ) as HTMLElement;
  const portfolioSummaryGaps = document.getElementById(
    'prep-portfolio-summary-gaps'
  ) as HTMLElement;
  const coverageSummary = document.getElementById(
    'prep-portfolio-coverage-summary'
  ) as HTMLElement;
  const gapsCount = document.getElementById(
    'prep-portfolio-gaps-count'
  ) as HTMLElement;
  const gapsList = document.getElementById(
    'prep-portfolio-gaps-list'
  ) as HTMLUListElement;
  const gapsDetails = gapsList.closest(
    'details'
  ) as HTMLDetailsElement | null;

  // Editor's currently-displayed portfolio ID (null = new/unsaved draft).
  let editorPortfolioId: string | null = null;

  function loadPortfolioIntoEditor(p: Portfolio | null): void {
    editorPortfolioId = p?.id ?? null;
    portfolioName.value = p?.name ?? '';
    const checkedIds = new Set(p?.storyIds ?? []);
    portfolioCheckboxes.forEach((cb) => {
      cb.checked = checkedIds.has(cb.dataset.storyId!);
    });
    portfolioDelete.disabled = !p;
    renderPortfolioPicker();
    renderCoverageInEditor();
    updateTreeCounts();
  }

  // ============================================================
  // Portfolio tree (project-grouped checklist) — Phase 6.8 Layer 1
  // ============================================================
  const runtimeProjects = Array.from(
    new Set(corpus.map((e) => e.project))
  ).sort();

  const treeGroupEls = Array.from(
    document.querySelectorAll<HTMLDetailsElement>('.prep__portfolio-tree-group')
  );

  function readTreeOpen(): Record<string, boolean> {
    try {
      const raw = localStorage.getItem(TREE_OPEN_KEY);
      if (!raw) return {};
      const parsed = JSON.parse(raw) as Record<string, boolean>;
      if (!parsed || typeof parsed !== 'object') return {};
      // Decision 013 silent stale filter — drop projects not in current corpus
      const validProjects = new Set(runtimeProjects);
      const filtered: Record<string, boolean> = {};
      for (const [k, v] of Object.entries(parsed)) {
        if (validProjects.has(k) && typeof v === 'boolean') filtered[k] = v;
      }
      return filtered;
    } catch {
      return {};
    }
  }

  function writeTreeOpen(state: Record<string, boolean>): void {
    try {
      if (Object.keys(state).length === 0) {
        localStorage.removeItem(TREE_OPEN_KEY);
        return;
      }
      localStorage.setItem(TREE_OPEN_KEY, JSON.stringify(state));
      if (!localStorage.getItem(SCHEMA_KEY)) {
        localStorage.setItem(SCHEMA_KEY, '1');
      }
    } catch {}
  }

  function syncTreeOpenState(): void {
    const state = readTreeOpen();
    treeGroupEls.forEach((d) => {
      const project = d.dataset.project!;
      if (project in state) {
        if (state[project]) d.setAttribute('open', '');
        else d.removeAttribute('open');
      }
      // Else: leave the HTML-default `open` attribute (all groups open on first load).
    });
  }

  function updateTreeCounts(): void {
    for (const project of runtimeProjects) {
      const countEl = document.getElementById(`prep-tree-counts-${project}`);
      if (!countEl) continue;
      const groupCheckboxes = portfolioCheckboxes.filter(
        (cb) =>
          cb.closest('.prep__portfolio-tree-group')?.getAttribute('data-project') ===
          project
      );
      const checked = groupCheckboxes.filter((cb) => cb.checked).length;
      const total = groupCheckboxes.length;
      countEl.textContent = `${checked} / ${total}`;
    }
  }

  treeGroupEls.forEach((d) => {
    d.addEventListener('toggle', () => {
      const state = readTreeOpen();
      state[d.dataset.project!] = d.open;
      writeTreeOpen(state);
    });
  });

  // ============================================================
  // Multi-story tabs (focus pane) — Phase 6.8 Layer 2
  // ============================================================
  const tabsNav = document.getElementById('prep-tabs') as HTMLElement;

  function renderTabHtml(
    entry: Entry,
    isUnpinned: boolean,
    isCurrent: boolean
  ): string {
    const cls = [
      'prep__tab',
      isCurrent ? 'prep__tab--current' : '',
      isUnpinned ? 'prep__tab--unpinned' : '',
    ]
      .filter(Boolean)
      .join(' ');
    return `<a
      class="${cls}"
      href="${escapeHtml(entry.href)}"
      data-story-id="${escapeHtml(entry.id)}"
      aria-current="${isCurrent ? 'true' : 'false'}"
    ><span class="prep__tab-project">${escapeHtml(entry.project)}</span><span class="prep__tab-tagline">${escapeHtml(entry.tagline)}</span></a>`;
  }

  function renderTabs(): void {
    const p = readPortfolio();
    if (!p || p.storyIds.length < 2) {
      tabsNav.hidden = true;
      tabsNav.innerHTML = '';
      return;
    }
    const corpusById = new Map(corpus.map((e) => [e.id, e]));
    const urlIsPinned = p.storyIds.includes(selectedStoryId);
    const tabs: string[] = [];
    if (!urlIsPinned) {
      const entry = corpusById.get(selectedStoryId);
      if (entry) {
        tabs.push(renderTabHtml(entry, true, true));
      }
    }
    for (const id of p.storyIds) {
      const entry = corpusById.get(id);
      if (!entry) continue;
      tabs.push(renderTabHtml(entry, false, id === selectedStoryId && urlIsPinned));
    }
    tabsNav.innerHTML = tabs.join('');
    tabsNav.hidden = false;
  }

  tabsNav.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;
    const link = target.closest('.prep__tab') as HTMLAnchorElement | null;
    if (!link || !link.dataset.storyId) return;
    recordClick(link.dataset.storyId);
    // Default <a href> page nav handles the navigation; no preventDefault.
  });

  function renderPortfolioPicker(): void {
    const { items, activeId } = readPortfolios();
    const pills: string[] = [];
    pills.push(
      `<button
        type="button"
        class="prep__portfolio-pill prep__portfolio-pill--new${editorPortfolioId === null ? ' prep__portfolio-pill--editing' : ''}"
        data-action="new"
      >+ New</button>`
    );
    for (const p of items) {
      const isActive = p.id === activeId;
      const isEditing = p.id === editorPortfolioId;
      const cls = [
        'prep__portfolio-pill',
        isActive ? 'prep__portfolio-pill--active' : '',
        isEditing ? 'prep__portfolio-pill--editing' : '',
      ]
        .filter(Boolean)
        .join(' ');
      const labelText =
        p.name.trim().length > 0
          ? p.name
          : `${p.storyIds.length} ${p.storyIds.length === 1 ? 'story' : 'stories'}`;
      pills.push(
        `<button
          type="button"
          class="${cls}"
          data-portfolio-id="${escapeHtml(p.id)}"
        >${escapeHtml(labelText)}${isActive ? '<span class="prep__portfolio-pill-dot" aria-label="Active">●</span>' : ''}</button>`
      );
    }
    portfolioPicker.innerHTML = pills.join('');
  }

  function syncPortfolioUI(): void {
    const p = readPortfolio();
    if (p) {
      portfolioLabel.textContent =
        p.name.trim().length > 0
          ? `Portfolio: ${p.name}`
          : `Portfolio (${p.storyIds.length} ${p.storyIds.length === 1 ? 'story' : 'stories'})`;
      portfolioDetails.classList.add('prep__portfolio--active');
    } else {
      portfolioLabel.textContent = 'Portfolio';
      portfolioDetails.classList.remove('prep__portfolio--active');
    }
    // Editor loads the active portfolio by default; user can switch via pills.
    const target =
      editorPortfolioId !== null
        ? readPortfolios().items.find((q) => q.id === editorPortfolioId) ?? p
        : p;
    loadPortfolioIntoEditor(target);
    updateSavedPortfolioGapBadge();
  }

  // ============================================================
  // Coverage-gap view
  // ============================================================
  type CoverageItem = { storyId: string; project: string; question: string };

  function computeCoverage(
    selectedIds: Set<string>
  ): { covered: CoverageItem[]; uncovered: CoverageItem[]; total: number } {
    const covered: CoverageItem[] = [];
    const uncovered: CoverageItem[] = [];
    corpus.forEach((entry) => {
      entry.questions.forEach((q) => {
        const row: CoverageItem = {
          storyId: entry.id,
          project: entry.project,
          question: q,
        };
        if (selectedIds.has(entry.id)) covered.push(row);
        else uncovered.push(row);
      });
    });
    return { covered, uncovered, total: covered.length + uncovered.length };
  }

  function renderCoverageInEditor(): void {
    const checkedIds = new Set(
      portfolioCheckboxes
        .filter((cb) => cb.checked)
        .map((cb) => cb.dataset.storyId!)
    );
    const { covered, uncovered, total } = computeCoverage(checkedIds);
    coverageSummary.textContent = `Coverage: ${covered.length} of ${total} questions`;
    if (uncovered.length === 0) {
      gapsCount.textContent = '';
      gapsList.innerHTML = '';
      if (gapsDetails) {
        gapsDetails.removeAttribute('open');
        gapsDetails.style.display = checkedIds.size > 0 ? 'none' : '';
      }
    } else {
      gapsCount.textContent = ` (${uncovered.length})`;
      if (gapsDetails) gapsDetails.style.display = '';
      gapsList.innerHTML = uncovered
        .map(
          (item) => `<li class="prep__portfolio-gap">
            <button
              class="prep__portfolio-gap-add"
              type="button"
              data-story-id="${escapeHtml(item.storyId)}"
              aria-label="Add ${escapeHtml(item.project)} story to portfolio"
              title="Add to portfolio"
            >+</button>
            <span class="prep__portfolio-gap-project">${escapeHtml(item.project)}</span>
            <span class="prep__portfolio-gap-question">${escapeHtml(item.question)}</span>
          </li>`
        )
        .join('');
    }
  }

  function updateSavedPortfolioGapBadge(): void {
    const p = readPortfolio();
    if (!p) {
      portfolioSummaryGaps.textContent = '';
      return;
    }
    const savedIds = new Set(p.storyIds);
    const { uncovered } = computeCoverage(savedIds);
    portfolioSummaryGaps.textContent =
      uncovered.length > 0 ? ` · ${uncovered.length} gaps` : '';
  }

  // Live re-render coverage + tree counts as user toggles portfolio checkboxes
  portfolioCheckboxes.forEach((cb) => {
    cb.addEventListener('change', () => {
      renderCoverageInEditor();
      updateTreeCounts();
    });
  });

  // "+" button on a gap row checks the corresponding story's checkbox in the
  // editor's in-progress selection (doesn't save until user clicks Save).
  gapsList.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;
    const btn = target.closest(
      '.prep__portfolio-gap-add'
    ) as HTMLButtonElement | null;
    if (!btn || !btn.dataset.storyId) return;
    e.preventDefault();
    const id = btn.dataset.storyId;
    const cb = portfolioCheckboxes.find((c) => c.dataset.storyId === id);
    if (cb && !cb.checked) {
      cb.checked = true;
      renderCoverageInEditor();
      updateTreeCounts();
    }
  });

  portfolioSave.addEventListener('click', () => {
    const name = portfolioName.value.trim();
    const ids = portfolioCheckboxes
      .filter((cb) => cb.checked)
      .map((cb) => cb.dataset.storyId!);
    if (ids.length === 0) {
      // Empty selection on Save → if editing existing, delete it; if new, no-op.
      if (editorPortfolioId !== null) {
        deletePortfolio(editorPortfolioId);
        editorPortfolioId = null;
      }
    } else {
      // Save activates the saved portfolio (selection = activation).
      const id = upsertPortfolio(editorPortfolioId, name, ids, true);
      editorPortfolioId = id;
    }
    syncPortfolioUI();
    portfolioDetails.removeAttribute('open');
    update();
  });

  portfolioDelete.addEventListener('click', () => {
    if (editorPortfolioId === null) return;
    deletePortfolio(editorPortfolioId);
    editorPortfolioId = null;
    syncPortfolioUI();
    update();
  });

  portfolioPicker.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;
    const pill = target.closest('.prep__portfolio-pill') as HTMLButtonElement | null;
    if (!pill) return;
    e.preventDefault();
    if (pill.dataset.action === 'new') {
      // Start a fresh draft — don't change active.
      loadPortfolioIntoEditor(null);
      portfolioName.focus();
      return;
    }
    const id = pill.dataset.portfolioId;
    if (!id) return;
    // Pill click = load into editor AND activate (selection = activation).
    editorPortfolioId = id;
    setActivePortfolio(id);
    syncPortfolioUI();
    update();
  });

  // ============================================================
  // Verify check-off
  // ============================================================
  const verifyDetails = document.querySelector(
    '.prep__details--verify'
  ) as HTMLDetailsElement | null;
  const verifySummary = verifyDetails
    ? (verifyDetails.querySelector('.prep__summary') as HTMLElement | null)
    : null;

  let verifyTotalItems = 0;
  let currentItemKeys: string[] = [];

  function augmentVerifyItems(): {
    totalItems: number;
    itemKeys: string[];
  } {
    const list = document.querySelector(
      '.prep__cue--verify .prep__prose ul'
    );
    if (!list) return { totalItems: 0, itemKeys: [] };
    const items = Array.from(list.querySelectorAll<HTMLLIElement>('li'));
    const keys: string[] = [];
    items.forEach((li) => {
      const text = li.textContent ?? '';
      const key = itemKey(text);
      keys.push(key);
      const label = document.createElement('label');
      label.className = 'prep__verify-item-label';
      const cb = document.createElement('input');
      cb.type = 'checkbox';
      cb.className = 'prep__verify-item-checkbox';
      cb.dataset.itemKey = key;
      const span = document.createElement('span');
      span.className = 'prep__verify-item-text';
      while (li.firstChild) span.appendChild(li.firstChild);
      label.appendChild(cb);
      label.appendChild(span);
      li.appendChild(label);
      li.classList.add('prep__verify-item');
    });
    return { totalItems: items.length, itemKeys: keys };
  }

  function updateVerifySummary(checked: number, total: number): void {
    if (!verifySummary || !verifyDetails) return;
    let countSpan = verifySummary.querySelector(
      '.prep__verify-count'
    ) as HTMLElement | null;
    if (!countSpan) {
      countSpan = document.createElement('span');
      countSpan.className = 'prep__verify-count';
      verifySummary.appendChild(countSpan);
    }
    if (total === 0 || checked === 0) {
      countSpan.textContent = '';
      verifyDetails.classList.remove('prep__details--verify--active');
    } else {
      countSpan.textContent = `(${checked} / ${total} verified)`;
      verifyDetails.classList.add('prep__details--verify--active');
    }
  }

  function syncVerifyUI(): void {
    if (verifyTotalItems === 0) {
      updateVerifySummary(0, 0);
      return;
    }
    const state = readVerify({ [selectedStoryId]: currentItemKeys });
    const checked = state[selectedStoryId] ?? {};
    let checkedCount = 0;
    const checkboxes = Array.from(
      document.querySelectorAll<HTMLInputElement>(
        '.prep__verify-item-checkbox'
      )
    );
    checkboxes.forEach((cb) => {
      const isChecked = !!checked[cb.dataset.itemKey!];
      cb.checked = isChecked;
      const li = cb.closest('li');
      if (li) li.classList.toggle('prep__verify-item--checked', isChecked);
      if (isChecked) checkedCount += 1;
    });
    updateVerifySummary(checkedCount, verifyTotalItems);
  }

  document.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement | null;
    if (
      !target ||
      target.tagName !== 'INPUT' ||
      !target.classList.contains('prep__verify-item-checkbox')
    ) return;
    const key = target.dataset.itemKey!;
    const state = readVerify({ [selectedStoryId]: currentItemKeys });
    const next = setVerifyItem(state, selectedStoryId, key, target.checked);
    writeVerify(next);
    const li = target.closest('li');
    if (li) li.classList.toggle('prep__verify-item--checked', target.checked);
    const checkboxes = Array.from(
      document.querySelectorAll<HTMLInputElement>(
        '.prep__verify-item-checkbox'
      )
    );
    const checkedCount = checkboxes.filter((cb) => cb.checked).length;
    updateVerifySummary(checkedCount, verifyTotalItems);
  });

  // ============================================================
  // Chip filters (project / shape)
  // ============================================================
  const chipsContainer = document.getElementById('prep-chips') as HTMLElement;

  chipsContainer.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;
    const chip = target.closest('.prep__chip') as HTMLButtonElement | null;
    if (!chip) return;
    e.preventDefault();
    const facet = chip.dataset.facet;
    const value = chip.dataset.value;
    if (!facet || !value) return;
    const set =
      facet === 'project'
        ? activeProjectChips
        : facet === 'shape'
        ? activeShapeChips
        : null;
    if (!set) return;
    if (set.has(value)) {
      set.delete(value);
      chip.setAttribute('aria-pressed', 'false');
      chip.classList.remove('prep__chip--active');
    } else {
      set.add(value);
      chip.setAttribute('aria-pressed', 'true');
      chip.classList.add('prep__chip--active');
    }
    update();
  });

  // ============================================================
  // Click delegation: persist frecency before navigation
  // ============================================================
  ribbon.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const link = target.closest('.prep__ribbon-item') as HTMLAnchorElement | null;
    if (link && link.dataset.storyId) {
      recordClick(link.dataset.storyId);
    }
  });

  input.addEventListener('input', update);

  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      selectedRibbonIndex += 1;
      applyRibbonSelection();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      selectedRibbonIndex -= 1;
      applyRibbonSelection();
    } else if (e.key === 'Enter') {
      const items = ribbonItems();
      const selected = items[selectedRibbonIndex];
      if (selected && selected.dataset.storyId) {
        e.preventDefault();
        recordClick(selected.dataset.storyId);
        window.location.href = selected.href;
      }
    } else if (e.key === 'Escape') {
      if (input.value !== '') {
        e.preventDefault();
        input.value = '';
        update();
      } else {
        input.blur();
      }
    }
  });

  document.addEventListener('keydown', (e) => {
    // Cmd+K / Ctrl+K — focus search from anywhere
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      input.focus();
      input.select();
      return;
    }
    // `d` — toggle Deploy/Drilling mode when not typing in an input
    if (
      e.key.toLowerCase() === 'd' &&
      !e.metaKey &&
      !e.ctrlKey &&
      !e.altKey
    ) {
      const target = e.target as HTMLElement;
      const inField =
        target &&
        (target.tagName === 'INPUT' ||
          target.tagName === 'TEXTAREA' ||
          target.isContentEditable);
      if (!inField) {
        e.preventDefault();
        modeToggle.click();
      }
    }
  });

  // ============================================================
  // Dev-only edit mode (Decision 015)
  // ============================================================
  // All edit-mode code is gated by `DEV` so the production bundle
  // tree-shakes it. No edit affordance, no fetch, no key handling.

  type SectionName =
    | 'Project orientation'
    | 'Opener'
    | 'Punchline'
    | 'Arc beats'
    | 'Verify';

  type DirtyPayload = {
    storyId: string;
    updates: {
      tagline?: string;
      questions?: string[];
      handles?: string[];
      sections?: Partial<Record<SectionName, string>>;
    };
  };

  const editDirty: DirtyPayload = {
    storyId: selectedStoryId,
    updates: {},
  };

  const prepRoot = document.querySelector('.prep') as HTMLElement | null;
  const editPill = document.getElementById('prep-edit-pill') as HTMLButtonElement | null;

  if (DEV) {
    // eslint-disable-next-line no-console
    console.log('[prep edit] dev edit mode initialized — chord: Cmd/Ctrl+E, button: EDIT pill in focus header');
  }

  function readEditMode(): boolean {
    if (!DEV) return false;
    try {
      return localStorage.getItem(EDIT_MODE_KEY) === '1';
    } catch {
      return false;
    }
  }

  function writeEditMode(on: boolean): void {
    if (!DEV) return;
    try {
      if (on) localStorage.setItem(EDIT_MODE_KEY, '1');
      else localStorage.removeItem(EDIT_MODE_KEY);
    } catch {}
  }

  function markDirty(el: HTMLElement, isDirty: boolean): void {
    if (isDirty) el.setAttribute('data-dirty', '1');
    else el.removeAttribute('data-dirty');
  }

  function collectQuestions(): string[] {
    const items = Array.from(
      document.querySelectorAll<HTMLElement>(
        '.prep__edit-list[data-edit-field="questions"] > li',
      ),
    );
    return items.map((li) => (li.textContent ?? '').trim()).filter((t) => t.length > 0);
  }

  function collectHandles(): string[] {
    const items = Array.from(
      document.querySelectorAll<HTMLElement>(
        '.prep__handles[data-edit-field="handles"] > li',
      ),
    );
    return items.map((li) => (li.textContent ?? '').trim()).filter((t) => t.length > 0);
  }

  function setEditableElements(on: boolean): void {
    if (!DEV) return;
    const tagline = document.querySelector<HTMLElement>(
      '[data-edit-field="tagline"]',
    );
    if (tagline) {
      if (on) tagline.setAttribute('contenteditable', 'plaintext-only');
      else {
        tagline.removeAttribute('contenteditable');
        markDirty(tagline, false);
      }
    }

    const questionItems = document.querySelectorAll<HTMLElement>(
      '.prep__edit-list[data-edit-field="questions"] > li',
    );
    questionItems.forEach((li) => {
      if (on) li.setAttribute('contenteditable', 'plaintext-only');
      else {
        li.removeAttribute('contenteditable');
        markDirty(li, false);
      }
    });

    const handleItems = document.querySelectorAll<HTMLElement>(
      '.prep__handles[data-edit-field="handles"] > li',
    );
    handleItems.forEach((li) => {
      if (on) li.setAttribute('contenteditable', 'plaintext-only');
      else {
        li.removeAttribute('contenteditable');
        markDirty(li, false);
      }
    });

    // Textareas already exist (rendered when isDev). Visibility is CSS-driven.
    // Clear dirty markers on them when turning off.
    if (!on) {
      const textareas = document.querySelectorAll<HTMLElement>(
        '.prep__edit-textarea',
      );
      textareas.forEach((t) => markDirty(t, false));
    }
  }

  function autoSizeTextarea(t: HTMLTextAreaElement): void {
    t.style.height = 'auto';
    t.style.height = t.scrollHeight + 'px';
  }

  let detailsOpenSnapshot: boolean[] | null = null;

  function snapshotDetailsAndOpenAll(): void {
    const detailsEls = Array.from(
      document.querySelectorAll<HTMLDetailsElement>('.prep__details'),
    );
    detailsOpenSnapshot = detailsEls.map((d) => d.open);
    detailsEls.forEach((d) => {
      d.open = true;
    });
  }

  function restoreDetailsSnapshot(): void {
    if (!detailsOpenSnapshot) return;
    const detailsEls = Array.from(
      document.querySelectorAll<HTMLDetailsElement>('.prep__details'),
    );
    detailsEls.forEach((d, i) => {
      const prior = detailsOpenSnapshot![i];
      if (prior !== undefined) d.open = prior;
    });
    detailsOpenSnapshot = null;
  }

  function applyEditMode(on: boolean): void {
    if (!DEV || !prepRoot) return;
    if (on) prepRoot.setAttribute('data-edit-mode', '1');
    else prepRoot.removeAttribute('data-edit-mode');
    if (editPill) {
      editPill.setAttribute('aria-pressed', on ? 'true' : 'false');
      editPill.classList.toggle('prep__edit-pill--active', on);
    }
    setEditableElements(on);
    if (on) {
      snapshotDetailsAndOpenAll();
      document
        .querySelectorAll<HTMLTextAreaElement>('.prep__edit-textarea')
        .forEach(autoSizeTextarea);
    } else {
      restoreDetailsSnapshot();
      // Clear in-memory dirty payload when leaving edit mode without saving.
      editDirty.updates = {};
    }
  }

  function focusTrailingEnd(el: HTMLElement): void {
    el.focus();
    const range = document.createRange();
    range.selectNodeContents(el);
    range.collapse(false);
    const sel = window.getSelection();
    if (sel) {
      sel.removeAllRanges();
      sel.addRange(range);
    }
  }

  function addListItem(
    list: HTMLElement,
    after: HTMLElement,
    max: number,
  ): HTMLElement | null {
    const items = Array.from(list.querySelectorAll(':scope > li'));
    if (items.length >= max) return null;
    const li = document.createElement('li');
    li.setAttribute('contenteditable', 'plaintext-only');
    after.after(li);
    // Re-index data-index attributes
    Array.from(list.querySelectorAll(':scope > li')).forEach((node, i) => {
      (node as HTMLElement).dataset.index = String(i);
    });
    focusTrailingEnd(li);
    return li;
  }

  function removeListItem(
    list: HTMLElement,
    li: HTMLElement,
    min: number,
  ): boolean {
    const items = Array.from(list.querySelectorAll(':scope > li'));
    if (items.length <= min) return false;
    const idx = items.indexOf(li);
    li.remove();
    Array.from(list.querySelectorAll(':scope > li')).forEach((node, i) => {
      (node as HTMLElement).dataset.index = String(i);
    });
    const remaining = Array.from(list.querySelectorAll<HTMLElement>(':scope > li'));
    const target = remaining[Math.max(0, idx - 1)];
    if (target) focusTrailingEnd(target);
    return true;
  }

  function syncTaglineEverywhere(newValue: string): void {
    if (!DEV) return;
    const trimmed = newValue.trim();
    // Ribbon — the "tabs at the top". Update the entry that matches the current story.
    document
      .querySelectorAll<HTMLElement>(
        `.prep__ribbon-item[data-story-id="${selectedStoryId}"] .prep__ribbon-tagline`,
      )
      .forEach((el) => {
        el.textContent = trimmed;
      });
    // Portfolio editor checklist (also shows taglines).
    document
      .querySelectorAll<HTMLElement>(
        `.prep__portfolio-checkbox[data-story-id="${selectedStoryId}"]`,
      )
      .forEach((cb) => {
        const taglineSpan = cb.parentElement?.querySelector<HTMLElement>(
          '.prep__portfolio-check-tagline',
        );
        if (taglineSpan) taglineSpan.textContent = trimmed;
      });
    // In-memory corpus, so search results pick up the new tagline.
    const entry = corpus.find((e) => e.id === selectedStoryId);
    if (entry) entry.tagline = trimmed;
    // Document title.
    if (trimmed.length > 0) document.title = `${trimmed} — Prep`;
  }

  if (DEV) {
    // Tagline input → dirty + live sync to ribbon
    const tagline = document.querySelector<HTMLElement>(
      '[data-edit-field="tagline"]',
    );
    tagline?.addEventListener('input', () => {
      const value = (tagline.textContent ?? '').trim();
      editDirty.updates.tagline = value;
      markDirty(tagline, true);
      syncTaglineEverywhere(value);
    });

    // Section textareas → dirty + auto-size
    document
      .querySelectorAll<HTMLTextAreaElement>('.prep__edit-textarea')
      .forEach((t) => {
        const name = t.dataset.sectionName as SectionName | undefined;
        if (!name) return;
        t.addEventListener('input', () => {
          if (!editDirty.updates.sections) editDirty.updates.sections = {};
          editDirty.updates.sections[name] = t.value;
          markDirty(t, true);
          autoSizeTextarea(t);
        });
      });

    // Questions list → dirty + Enter/Backspace handling
    const questionsList = document.querySelector<HTMLElement>(
      '.prep__edit-list[data-edit-field="questions"]',
    );
    if (questionsList) {
      questionsList.addEventListener('input', () => {
        editDirty.updates.questions = collectQuestions();
        questionsList.querySelectorAll<HTMLElement>(':scope > li').forEach((li) => markDirty(li, true));
      });
      questionsList.addEventListener('keydown', (e: KeyboardEvent) => {
        if (!readEditMode()) return;
        const target = e.target as HTMLElement;
        const li = target.closest('li');
        if (!li || li.parentElement !== questionsList) return;
        if (e.key === 'Enter') {
          e.preventDefault();
          if (addListItem(questionsList, li, 3)) {
            editDirty.updates.questions = collectQuestions();
          }
        } else if (e.key === 'Backspace' && (li.textContent ?? '').trim().length === 0) {
          if (removeListItem(questionsList, li, 1)) {
            e.preventDefault();
            editDirty.updates.questions = collectQuestions();
          }
        }
      });
    }

    // Handles list → dirty + Enter/Backspace handling
    const handlesList = document.querySelector<HTMLElement>(
      '.prep__handles[data-edit-field="handles"]',
    );
    if (handlesList) {
      handlesList.addEventListener('input', () => {
        editDirty.updates.handles = collectHandles();
        handlesList.querySelectorAll<HTMLElement>(':scope > li').forEach((li) => markDirty(li, true));
      });
      handlesList.addEventListener('keydown', (e: KeyboardEvent) => {
        if (!readEditMode()) return;
        const target = e.target as HTMLElement;
        const li = target.closest('li');
        if (!li || li.parentElement !== handlesList) return;
        if (e.key === 'Enter') {
          e.preventDefault();
          if (addListItem(handlesList, li, 3)) {
            editDirty.updates.handles = collectHandles();
          }
        } else if (e.key === 'Backspace' && (li.textContent ?? '').trim().length === 0) {
          if (removeListItem(handlesList, li, 1)) {
            e.preventDefault();
            editDirty.updates.handles = collectHandles();
          }
        }
      });
    }

    // EDIT pill click → toggle
    editPill?.addEventListener('click', () => {
      const next = !readEditMode();
      writeEditMode(next);
      applyEditMode(next);
    });

    // Cmd+E / Ctrl+E toggle, Cmd+S / Ctrl+S log payload (save lands in slice 2)
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      const mod = e.metaKey || e.ctrlKey;
      if (!mod) return;
      const key = e.key.toLowerCase();
      if (key === 'e') {
        e.preventDefault();
        e.stopPropagation();
        const next = !readEditMode();
        writeEditMode(next);
        applyEditMode(next);
        // eslint-disable-next-line no-console
        console.log('[prep edit] toggled via chord →', next);
      } else if (key === 's' && readEditMode()) {
        e.preventDefault();
        // Save endpoint lands in session-edit-mode-save.md. For now, surface payload.
        // eslint-disable-next-line no-console
        console.log('[prep edit] dirty payload (save not yet wired):', JSON.parse(JSON.stringify(editDirty)));
      }
    }, { capture: true });
  }

  // ============================================================
  // Initial hydration
  // ============================================================
  // Augment verify items before applyMode so drilling-mode auto-open
  // sees the augmented HTML (no FOUC of unaugmented items).
  {
    const meta = augmentVerifyItems();
    verifyTotalItems = meta.totalItems;
    currentItemKeys = meta.itemKeys;
    syncVerifyUI();
  }

  applyMode(readMode());
  syncTreeOpenState();
  syncPortfolioUI();
  renderTabs();

  if (DEV) {
    applyEditMode(readEditMode());
  }

  const initialFrec = readFrecency();
  const initialPortfolio = readPortfolio();
  if (
    initialPortfolio ||
    hasAnyFrecency(initialFrec, Date.now()) ||
    input.value.length > 0
  ) {
    update();
  } else {
    applyRibbonSelection();
  }
</script>

